    {
      "name": "4 · Carga (usar con Runner + docker stats)",
      "description": "Ejecutar con Collection Runner: 300 a 1000 iteraciones, delay 0 ms. En otra terminal: docker stats servicio-ia. De ahí sale el número del mem_limit (IE2) y la latencia (IE8).",
      "item": [
        {
          "name": "POST /predict · lectura aleatoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predict"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{lectura_aleatoria}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = (a, b, d = 1) => Math.round((a + Math.random() * (b - a)) * d) / d;",
                  "const lectura = {",
                  "  antiguedad_anios: r(1, 14), horas_desde_mantencion: r(0, 900),",
                  "  carga_promedio_ton: r(260, 400, 10), temp_motor_c: r(78, 104, 10),",
                  "  presion_aceite_psi: r(38, 66, 10), vibracion_mm_s: r(2, 9, 100),",
                  "  rpm_promedio: r(1300, 2000), alertas_24h: r(0, 4),",
                  "  flota: [\"A\", \"B\", \"C\"][r(0, 2)], turno: Math.random() < 0.5 ? \"dia\" : \"noche\"",
                  "};",
                  "pm.variables.set(\"lectura_aleatoria\", JSON.stringify(lectura));"
                ]
              }
            }
          ]
        }
      ]
    }
