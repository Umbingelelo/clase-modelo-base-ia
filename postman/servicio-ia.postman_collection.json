    {
      "name": "1 · Operación",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Lo que consultan Docker (HEALTHCHECK), el gateway y el balanceador. 200 = la réplica recibe tráfico; 503 = la sacan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"modelo cargado\", () => pm.expect(r.modelo_cargado).to.be.true);",
                  "pm.collectionVariables.set(\"version_modelo\", r.version_modelo);",
                  "console.log(\"Version del modelo:\", r.version_modelo, \"| revision:\", r.revision);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /modelo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/modelo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo"
              ]
            },
            "description": "Metadata del modelo servido: versión, algoritmo, umbral, métricas y cifras de limpieza."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"tiene umbral y metricas\", () => { pm.expect(r).to.have.property(\"umbral\"); pm.expect(r).to.have.property(\"metricas_prueba\"); });"
                ]
              }
            }
          ]
        }
      ]
