    {
      "name": "2 · Predicción",
      "item": [
        {
          "name": "POST /predict · camión en riesgo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predict"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"antiguedad_anios\": 11,\n  \"horas_desde_mantencion\": 620,\n  \"carga_promedio_ton\": 395,\n  \"temp_motor_c\": 99.5,\n  \"presion_aceite_psi\": 41.0,\n  \"vibracion_mm_s\": 7.8,\n  \"rpm_promedio\": 1980,\n  \"alertas_24h\": 3,\n  \"flota\": \"C\",\n  \"turno\": \"noche\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"probabilidad entre 0 y 1\", () => pm.expect(r.probabilidad_falla).to.be.within(0, 1));",
                  "pm.test(\"incluye version del modelo (requisito EP2)\", () => pm.expect(r.version_modelo).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"misma version que reporta /health\", () => {",
                  "    const v = pm.collectionVariables.get(\"version_modelo\");",
                  "    if (v) pm.expect(r.version_modelo).to.eql(v);",
                  "});",
                  "pm.test(\"responde en menos de 300 ms\", () => pm.expect(pm.response.responseTime).to.be.below(300));",
                  "",
                  "pm.test(\"debe alertar\", () => pm.expect(r.alerta).to.be.true);"
                ]
              }
            }
          ]
        },
